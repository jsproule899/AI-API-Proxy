<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Welcome Email</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        /* Responsive styles */
        @media only screen and (max-width: 620px) {
            .email-container {
                width: 100% !important;
                padding-left: 10px;
            }
        }
    </style>
</head>

<body style="margin:0; padding:0; background-color:#d6000d; font-family:sans-serif;">

    <!-- Wrapper Table -->
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" align="center"
        style="background-color:#d6000d; padding: 30px 0;">
        <!-- Logo Section -->
        <tr>
            <td align="center">
                <!-- Email Container -->
                <table role="presentation" class="email-container" width="600" cellspacing="0" cellpadding="0"
                    border="0" style="text-align:center;">
                    <tr>
                        <td align="left" style="padding-bottom: 20px;">
                            <img src="https://www.qub.ac.uk/schools/media/Media,767339,en.svg"
                                alt="Queens University Belfast School of Pharmacy Logo" height="60"
                                style="display:inline-block; vertical-align:middle; margin-right:15px; padding-right: 10px; border-right: solid #fff 2px;">
                            <span class="logo-text"
                                style="color:#fff; font-size:14px; text-transform:uppercase; display:inline-block; vertical-align:top;">
                                <span style="display:block; font-size:12px;" align="left">School of</span>
                                <strong style="font-size:16px;" align="left">Pharmacy</strong>
                            </span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td align="center">
                <!-- Email Container -->
                <table role="presentation" class="email-container" width="600" cellspacing="0" cellpadding="0"
                    border="0" style="background-color: #fafaf9; border-radius:5px; padding: 40px; text-align:center;">
                    <!-- Content Section -->
                    <tr>
                        <td class="email-content">
                            <h2 style="color:#000; font-size:24px; margin-bottom:40px;">Welcome!</h2>
                            <p style="color:#000; font-size:16px;">Hi {{studentNo}},</p>
                            <p style="color:#000; font-size:16px;">
                                You've been granted access to the QAIRx Platform.
                            </p>
                            <p style="color:#000; font-size:16px;">
                                Your temporary password is:
                            </p>
                            <p style="font-weight: 600; text-align: center;">
                                {{password}}
                            </p>
                            <!-- Log In Button -->
                            <a href="https://{{link}}" target="_blank"
                                style="display:inline-block; margin:20px 0; background-color:#d6000d; color:#fff; font-weight:bold; padding:12px 24px; text-decoration:none; border-radius:5px; font-size:16px;">
                                Log In
                            </a>

                            <p style="color:#000; font-size:16px;">
                                If you didn't request access or no longer require an account, you can simply ignore this
                                message.
                            </p>

                            <hr style="border:none; border-top:1px solid #ccc; margin:20px 0;">

                            <h3 style="color:#000; font-size:20px;">Issue with the link?</h3>
                            <p style="color:#000; font-size:16px;">Copy and paste this link into your browser:
                            </p>
                            <a href="https://{{link}}" style="color:#d6000d; font-size:16px;">https://{{link}}</a>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>

</html>